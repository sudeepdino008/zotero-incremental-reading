{
  "name": "zotero-incremental-reading",
  "type": "module",
  "version": "0.1.3",
  "description": "SuperMemo-style incremental reading queue for Zotero",
  "config": {
    "addonName": "Incremental Reading",
    "addonID": "incremental-reading@sudeepdino008",
    "addonRef": "increading",
    "addonInstance": "IncrementalReading",
    "prefsPrefix": "extensions.zotero.increading"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sudeepdino008/zotero-incremental-reading.git"
  },
  "author": "sudeepdino008",
  "bugs": {
    "url": "https://github.com/sudeepdino008/zotero-incremental-reading/issues"
  },
  "homepage": "https://github.com/sudeepdino008/zotero-incremental-reading#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^6.0.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@zotero-plugin/eslint-config": "^0.6.10",
    "chai": "^6.3.0",
    "eslint": "^10.13.0",
    "mocha": "^12.0.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "zotero-plugin-scaffold": "^0.9.3",
    "zotero-types": "^4.1.3"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
